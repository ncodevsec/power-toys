{
	"manifest_version": 3,
	"name": "Power Toys",
	"version": "1.0.0",
	"description": "Essential toolkit for pentesters and bug hunters. Quickly extract links, encode/decode data, and simplify everyday security tasks.",
	"permissions": [
		"activeTab",
		"scripting",
		"storage",
		"contextMenus",
		"cookies",
		"webRequest",
		"alarms",
		"clipboardWrite"
	],
	"host_permissions": [
		"<all_urls>"
	],
	"background": {
		"scripts": [
			"src/scripts/background.js"
		]
	},
	"icons": {
		"16": "assets/images/power-toys-16.png",
		"48": "assets/images/power-toys-48.png",
		"128": "assets/images/power-toys-128.png"
	},
	"action": {
		"default_popup": "src/pages/popup.html",
		"default_title": "Power Toys - Simplify everyday security tasks",
		"default_icon": {
			"16": "assets/images/power-toys-16.png",
			"48": "assets/images/power-toys-48.png",
			"128": "assets/images/power-toys-128.png"
		}
	},
	"commands": {
		"open-palette": {
			"suggested_key": { "default": "Ctrl+Shift+K", "mac": "Command+Shift+K" },
			"description": "Open the command palette"
		},
		"auto-decode-selection": {
			"suggested_key": { "default": "Ctrl+Shift+D", "mac": "Command+Shift+D" },
			"description": "Auto-decode the selected text"
		},
		"open-full-tab": {
			"description": "Open Power Toys in a full tab"
		}
	},
	"content_security_policy": {
		"extension_pages": "script-src 'self'; object-src 'none';"
	},
	"author": "ncodevsec",
	"homepage_url": "https://github.com/ncodevsec",
	"browser_specific_settings": {
		"gecko": {
			"id": "power-toys@ncodevsec"
		}
	}
}
