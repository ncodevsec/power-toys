{
	"name": "power-toys",
	"version": "0.5.2",
	"description": "Essential toolkit for pentesters and bug hunters. Quickly extract links, encode/decode data, and simplify everyday security tasks.",
	"main": "build.js",
	"directories": {
		"doc": "docs"
	},
	"scripts": {
		"build": "node build.js",
		"build:css": "tailwindcss -i ./src/styles/input.css -o ./src/styles/tailwind.min.css",
		"dev": "node build.js --watch"
	},
	"keywords": [
		"security",
		"pentesting",
		"bug-hunting",
		"encoding",
		"decoding",
		"chrome-extension",
		"firefox-extension"
	],
	"author": "ncodevsec",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/ncodevsec/power-toys"
	},
	"homepage": "https://github.com/ncodevsec/power-toys",
	"dependencies": {
		"@tailwindcss/cli": "^4.3.0",
		"tailwindcss": "^4.3.0"
	}
}
